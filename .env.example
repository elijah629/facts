# Pooled Neon URL for the app runtime (hostname contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full
# Direct Neon URL used only by Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
FACTS_SOURCE_ENCRYPTION_KEY=
# Vercel Cron automatically sends this as Authorization: Bearer <value>.
CRON_SECRET=
